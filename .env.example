PORT=8787
DATA_DIR=./data
# Required in production. Development mode unlocks admin only when this is empty.
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Optional initial admin provider. Public users can also bring their own URL/key/model per request.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
