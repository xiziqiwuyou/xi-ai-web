PORT=8787
DATA_DIR=./data
# Set to 1 when exactly one trusted reverse proxy sits in front of the app.
TRUST_PROXY_HOPS=0
# Required in production. Development mode unlocks admin only when this is empty.
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Public users provide only their API Key in the browser. Provider requests use this administrator-managed gateway.
UPSTREAM_BASE_URL=https://api.xi-ai.cn

# Optional Langflow runtime. Keep disabled until a private Langflow service is ready.
LANGFLOW_ENABLED=false
LANGFLOW_BASE_URL=http://langflow:7860
LANGFLOW_API_KEY=
LANGFLOW_WORKFLOW_PATH=/api/v2/workflows
LANGFLOW_REQUEST_TIMEOUT_MS=120000
LANGFLOW_RATE_LIMIT_WINDOW_MS=60000
LANGFLOW_RATE_LIMIT_MAX_REQUESTS=12

# Cloud knowledge is isolated from the public BYOK workspace and disabled by default.
KNOWLEDGE_ENABLED=false
# Required only when cloud knowledge is enabled; generate a random 32+ character secret.
KNOWLEDGE_TOKEN_SECRET=replace-with-a-long-random-knowledge-secret
KNOWLEDGE_SESSION_TTL_SECONDS=1209600
# PostgreSQL 17+ with the pgvector extension. Run `npm run knowledge:migrate` before enabling.
DATABASE_URL=postgresql://xi_ai:change-me@127.0.0.1:5432/xi_ai
# Optional elevated migration-only role. Runtime startup only verifies migrations.
KNOWLEDGE_MIGRATION_DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
KNOWLEDGE_DATABASE_CONNECT_TIMEOUT_MS=5000
KNOWLEDGE_DATABASE_POOL_MAX=10
# Tencent COS server credentials. Never expose these values to browser code.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=example-1250000000
COS_REGION=ap-guangzhou
COS_APP_ID=1250000000
KNOWLEDGE_COS_UPLOAD_GRANT_TTL_SECONDS=900
KNOWLEDGE_COS_SOURCE_URL_TTL_SECONDS=300
PUBLIC_ORIGIN=http://localhost:8787
KNOWLEDGE_WORKER_CONCURRENCY=2
KNOWLEDGE_WORKER_LEASE_SECONDS=60
KNOWLEDGE_EMBEDDING_LEASE_SECONDS=120
KNOWLEDGE_EMBEDDING_REQUEST_TIMEOUT_MS=60000
