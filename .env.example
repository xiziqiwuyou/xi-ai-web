# Copy this file to .env before running `docker compose pull`.
# Replace every change-me value. Never commit the resulting .env file.

# Container internals; normally keep these values unchanged.
NODE_ENV=production
PORT=8787
DATA_DIR=/app/data

# Main application and operator account
ADMIN_USERNAME=xizi2333
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
APP_PASSWORD=
APP_SESSION_SECRET=
UPSTREAM_BASE_URL=https://api.xi-ai.cn
# Set true only when the Admin Site Settings page should be allowed to change
# the upstream gateway away from the environment value.
ALLOW_ADMIN_UPSTREAM_OVERRIDE=false
ALLOW_LOCAL_UPSTREAM=false
TRUST_PROXY_HOPS=1
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8787
XI_AI_WEB_IMAGE=ghcr.io/xiziqiwuyou/xi-ai-web:v0.0.1

# Main request limits and timeouts
UPSTREAM_TIMEOUT_MS=120000
IMAGE_UPSTREAM_TIMEOUT_MS=300000
IMAGE_IMPORT_TIMEOUT_MS=30000
SSE_HEARTBEAT_MS=15000
REQUEST_RATE_WINDOW_MS=60000
REQUEST_RATE_MAX_REQUESTS=120
REQUEST_MAX_CONCURRENT=32
CHAT_RATE_LIMIT_MAX=30
CHAT_MAX_CONCURRENT=8
GENERATION_RATE_LIMIT_MAX=20
GENERATION_MAX_CONCURRENT=4
IMAGE_IMPORT_RATE_LIMIT_MAX=12
IMAGE_IMPORT_MAX_CONCURRENT=2
IMAGE_TIMING_RATE_LIMIT_MAX=120
IMAGE_TIMING_MAX_CONCURRENT=8
EMBEDDING_RATE_LIMIT_MAX=20
EMBEDDING_MAX_CONCURRENT=4
SHELL_AUTH_RATE_LIMIT_MAX=10
SHELL_AUTH_MAX_CONCURRENT=2
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_LOGIN_MAX_CONCURRENT=2

# Temporary cross-device sync. Keep disabled until HTTPS is configured.
PROGRESS_SYNC_ENABLED=false
PROGRESS_SYNC_TTL_SECONDS=600
PROGRESS_SYNC_MAX_PAYLOAD_MB=32
PROGRESS_SYNC_MAX_IP_ATTEMPTS=5
PROGRESS_SYNC_MAX_SESSION_ATTEMPTS=5
PROGRESS_SYNC_RATE_LIMIT_MAX=240
PROGRESS_SYNC_MAX_CONCURRENT=16

# Optional knowledge profile: `docker compose --profile knowledge up -d`
KNOWLEDGE_ENABLED=false
KNOWLEDGE_TOKEN_SECRET=replace-with-a-long-random-knowledge-secret
KNOWLEDGE_SESSION_TTL_SECONDS=1209600
POSTGRES_USER=xi_ai
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=xi_ai
# The password in this URL must be URL-encoded if it contains reserved characters.
DATABASE_URL=postgresql://xi_ai:replace-with-a-strong-database-password@postgres:5432/xi_ai
KNOWLEDGE_MIGRATION_DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
KNOWLEDGE_DATABASE_CONNECT_TIMEOUT_MS=5000
KNOWLEDGE_DATABASE_POOL_MAX=10
# Tencent COS server credentials. These never go to browser code.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=example-1250000000
COS_REGION=ap-guangzhou
COS_APP_ID=1250000000
KNOWLEDGE_COS_UPLOAD_GRANT_TTL_SECONDS=900
KNOWLEDGE_COS_SOURCE_URL_TTL_SECONDS=300
PUBLIC_ORIGIN=https://your-domain.example
KNOWLEDGE_WORKER_CONCURRENCY=2
KNOWLEDGE_WORKER_LEASE_SECONDS=60
KNOWLEDGE_EMBEDDING_LEASE_SECONDS=120
KNOWLEDGE_EMBEDDING_REQUEST_TIMEOUT_MS=60000

# Optional Langflow profile: `docker compose --profile langflow up -d`
LANGFLOW_ENABLED=false
LANGFLOW_BASE_URL=http://langflow:7860
LANGFLOW_API_KEY=
LANGFLOW_WORKFLOW_PATH=/api/v2/workflows
LANGFLOW_REQUEST_TIMEOUT_MS=120000
LANGFLOW_RATE_LIMIT_WINDOW_MS=60000
LANGFLOW_RATE_LIMIT_MAX_REQUESTS=12
LANGFLOW_IMAGE=langflowai/langflow:latest
LANGFLOW_PORT=7860
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=replace-with-a-strong-langflow-password
LANGFLOW_SECRET_KEY=replace-with-a-long-random-langflow-secret
