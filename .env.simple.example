# Required: use a strong, unique password for the private admin entry.
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: the default username is xizi2333.
# ADMIN_USERNAME=xizi2333

# Keep 127.0.0.1 when using a 1Panel/Nginx reverse proxy.
# Set 0.0.0.0 only when direct access to SERVER_IP:8787 is intentional.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8787

# The public app sends users' API keys to this fixed gateway.
UPSTREAM_BASE_URL=https://api.xi-ai.cn

# Keep temporary cross-device sync disabled until HTTPS is configured.
PROGRESS_SYNC_ENABLED=false
