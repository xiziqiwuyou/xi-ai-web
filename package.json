{
  "name": "xi-ai-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "description": "A self-hostable web AI studio inspired by Cherry Studio.",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "start": "node server/index.mjs --production",
    "clean:cache": "node scripts/clean-cache.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release-check": "npm run build && node scripts/release-check.mjs",
    "ui-contract": "node scripts/ui-contract.mjs",
    "ui-runtime": "node scripts/ui-runtime.mjs",
    "feature-audit": "node scripts/feature-audit.mjs",
    "provider-contracts": "node scripts/provider-contracts.mjs",
    "chat-local-contracts": "node scripts/chat-local-contracts.mjs",
    "workspace-storage-contracts": "node scripts/workspace-storage-contracts.mjs",
    "automation-contracts": "node scripts/automation-contracts.mjs",
    "search-contracts": "node scripts/search-contracts.mjs",
    "prompt-tool-contracts": "node scripts/prompt-tool-contracts.mjs",
    "knowledge:migrate": "node server/knowledge-cloud/migrate.mjs",
    "knowledge:migrate:check": "node server/knowledge-cloud/migrate.mjs --check",
    "knowledge:worker": "node server/knowledge-cloud/worker.mjs",
    "test:langflow": "node --test tests/langflow/*.test.mjs",
    "test:knowledge": "node --test tests/knowledge-cloud/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:server": "node --test tests/server/*.test.mjs",
    "test:knowledge:db": "node --test tests/knowledge-cloud/postgres.integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "privacy": "node scripts/privacy-scan.mjs",
    "qa": "npm run check && npm run build && npm run privacy && npm run ui-contract && npm run feature-audit && npm run provider-contracts && npm run prompt-tool-contracts && npm run chat-local-contracts && npm run workspace-storage-contracts && npm run automation-contracts && npm run search-contracts && npm run test:langflow && npm run test:knowledge && npm run test:security && npm run test:server && npm run test:knowledge:db && npm run ui-runtime && npm run release-check"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "cos-nodejs-sdk-v5": "3.0.0",
    "csv-parse": "7.0.1",
    "express": "^5.2.1",
    "file-type": "22.0.1",
    "katex": "0.16.47",
    "lucide-react": "^1.16.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.1.200",
    "pg": "8.22.0",
    "pgvector": "0.3.0",
    "pptxgenjs": "^4.0.1",
    "qcloud-cos-sts": "3.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "saxes": "6.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "yazl": "3.3.1"
  }
}
