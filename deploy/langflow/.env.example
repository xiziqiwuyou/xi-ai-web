# Pin this to a reviewed Langflow release before production use.
LANGFLOW_IMAGE=langflowai/langflow:latest
LANGFLOW_PORT=7860
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=replace-with-a-strong-langflow-password
LANGFLOW_SECRET_KEY=replace-with-a-long-random-langflow-secret

# The main xi-ai-web container reaches this service as http://langflow:7860.
# Keep this stack on the private xi-ai Docker network.
